# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
#
# No credentials belong in this file: the database password and JWT signing key
# are generated by Terraform and stored in AWS Secrets Manager.

aws_region  = "us-east-1"
environment = "dev"

# Required only if you want the GitHub Actions deployment role created.
# github_repository = "your-github-username/coursepulse"

# Set to false if this AWS account already has a GitHub OIDC provider.
# create_github_oidc_provider = true

# Only if GitHub sends immutable OIDC subjects (the deploy fails with
# "Not authorized to perform sts:AssumeRoleWithWebIdentity"). Copy the
# sub_claim_prefix from: gh api repos/OWNER/REPO/actions/oidc/customization/sub
# github_oidc_subject_prefix = "repo:your-org@123456/coursepulse@789012"

# Deployed image tag. CI and scripts/deploy.sh pass the Git commit SHA.
# container_image_tag = "latest"

# --- cost controls (defaults are already the cheap options) ---
# task_cpu             = 256
# task_memory          = 512
# desired_count        = 1
# db_instance_class    = "db.t4g.micro"
# db_allocated_storage = 20
# log_retention_days   = 7

# --- autoscaling ---
# enable_autoscaling       = true
# autoscaling_min_capacity = 1
# autoscaling_max_capacity = 3
# autoscaling_cpu_target   = 60

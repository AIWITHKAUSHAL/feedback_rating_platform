# CoursePulse local environment example.
#
#   cp .env.example .env
#
# NEVER commit the real .env - it is listed in .gitignore. On AWS these values
# come from ECS task environment variables and AWS Secrets Manager, not files.

# ------------------------------------------------------------------ database
POSTGRES_USER=coursepulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=coursepulse
POSTGRES_PORT=5432

# Used when running the backend directly on the host (outside Docker Compose).
# Inside Compose the host is `postgres`, and the value is set in the compose file.
DATABASE_URL=postgresql+psycopg://coursepulse:change-me-locally@localhost:5432/coursepulse

# Separate throwaway database for `make test` (created by `make test-db`).
TEST_DATABASE_URL=postgresql+psycopg://coursepulse:coursepulse@localhost:5433/coursepulse_pytest

# --------------------------------------------------------------- application
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------ security
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-long-random-value-for-every-environment
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------- admin bootstrap (local)
# Consumed only by `make create-admin` / app.scripts.create_admin.
# Choose your own password; it is hashed with bcrypt before storage.
ADMIN_EMAIL=admin@coursepulse.dev
ADMIN_PASSWORD=choose-a-strong-local-password

# ----------------------------------------------------------------- frontend
# Empty = relative /api requests (Vite proxy locally, CloudFront in production).
VITE_API_BASE_URL=

# ----------------------------------------------------------- aws deployment
# Only needed by scripts/deploy.sh and Terraform. Credentials themselves come
# from your AWS profile or GitHub Actions OIDC - never from this file.
AWS_REGION=us-east-1
AWS_PROFILE=default

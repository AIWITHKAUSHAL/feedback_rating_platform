# Frontend environment example. Copy to .env.local for local development.
#
# Leave EMPTY to use relative "/api" requests:
#   - local dev: Vite proxies /api to http://localhost:8000 (see vite.config.ts)
#   - production: CloudFront routes /api/* to the ALB (same origin, no CORS)
VITE_API_BASE_URL=

# Only needed if you want to bypass the dev proxy and call the API directly.
# VITE_API_BASE_URL=http://localhost:8000
